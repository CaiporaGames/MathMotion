[{"slug":"retangulo-maior-area","title":"O mesmo contorno. Mais espaço?","subtitle":"Descobre por que razão o quadrado ganha esta corrida.","topic":"Geometria","years":[7,8,9,10],"minutes":18,"image":"/images/garden.svg","imageAlt":"Ilustração de um jardim retangular com vedação e plantas.","accent":"green","date":"2026-10-30","problem":"Tens 20 metros de vedação para construir um jardim retangular. Que dimensões dão a maior área? Considera quatro lados vedados e nenhuma abertura.","question":"Um jardim muito comprido consegue ter mais espaço do que um jardim quase quadrado?","hints":["O perímetro é a soma dos quatro lados: 2a + 2b = 20.","Se a + b = 10, então conhecer a permite calcular b = 10 − a.","Compara 4 × 6, 5 × 5 e 6 × 4. O que acontece à mesma distância do centro?"],"tool":"area","toolConfig":{"perimeter":20,"initial":{"a":3},"title":"O teu jardim, as tuas medidas","prompt":"Mantém os 20 m de vedação. Arrasta o controlo e procura a maior área."},"steps":[{"title":"O que fica fixo?","text":"O perímetro é 20 m. Cada par de lados opostos tem o mesmo comprimento. Dividimos o perímetro por dois e obtemos a soma de dois lados vizinhos.","formula":"2a+2b=20\\quad\\Rightarrow\\quad a+b=10"},{"title":"Uma medida determina a outra","text":"Se um lado medir 3 m, o outro mede 7 m. Para um lado a, o outro será 10 − a. A área é o produto dos lados.","formula":"A(a)=a(10-a),\\qquad 0<a<10"},{"title":"Experimentar dá uma conjectura","text":"Os pares (3, 7), (4, 6) e (5, 5) dão 21, 24 e 25 m². Parece que os lados iguais ganham. A tabela sugere uma resposta; ainda precisamos de a justificar."},{"title":"Porque nenhum outro retângulo ganha","text":"Escrevemos a = 5 + d e b = 5 − d. Como d² nunca é negativo, a área nunca ultrapassa 25 m². A igualdade acontece apenas quando d = 0.","formula":"A=(5+d)(5-d)=25-d^2\\leq25"},{"title":"A resposta, com unidades","text":"O jardim com área máxima é um quadrado de lado 5 m, com área de 25 m². Se permitirmos um lado nulo, obtemos um caso degenerado com área zero."}],"takeaways":["Perímetro mede contorno; área mede superfície.","Casos simétricos podem revelar uma estrutura.","Uma conjectura nasce de experiências; uma demonstração explica todos os casos."],"exercises":[{"question":"Com 24 m de vedação, que retângulo tem a maior área?","hint":"A soma de dois lados vizinhos passa a ser 12.","answer":"6 m × 6 m; área máxima de 36 m².","explanation":"A área é (6 + d)(6 − d) = 36 − d²."},{"question":"Com 20 m de vedação, um lado mede 2 m. Qual é a área?","hint":"Não uses 20 − 2 para o outro lado: conta os quatro lados.","answer":"16 m².","explanation":"O outro lado mede 8 m, pois 2 + 8 = 10. A área é 2 × 8."}]},{"slug":"desconto-que-nao-volta","title":"Sobe 20%. Desce 20%. Voltou?","subtitle":"O pequeno detalhe que muda a tua conta.","topic":"Números","years":[6,7,8,9],"minutes":15,"image":"/images/prices.svg","imageAlt":"Ilustração de etiquetas de preço com setas de aumento e desconto.","accent":"purple","date":"2026-10-29","problem":"Uma mochila custa 50 €. O preço aumenta 20% e depois recebe um desconto de 20%. O preço final volta aos 50 €?","question":"Antes de calcular: achas que acaba mais cara, mais barata ou igual?","hints":["20% de 50 € são 10 €. Qual é o preço depois do aumento?","O desconto é calculado sobre o novo preço, não sobre os 50 € iniciais.","Um aumento de 20% multiplica por 1,20. Um desconto de 20% multiplica por 0,80."],"tool":"percent","toolConfig":{"initial":{"price":50,"up":20,"down":20},"title":"Segue o preço","prompt":"Muda o aumento e o desconto. Repara no valor sobre o qual cada percentagem atua."},"steps":[{"title":"Transformar percentagens em valores","text":"Uma percentagem é uma razão por cem. Para calcular 20% de 50 €, multiplicamos 50 por 0,20.","formula":"50\\times\\frac{20}{100}=10"},{"title":"Aplicar o aumento","text":"Somamos os 10 € ao preço inicial. Também podemos fazer tudo numa multiplicação.","formula":"50(1+0{,}20)=60"},{"title":"A base de cálculo mudou","text":"Agora retiramos 20% de 60 €, ou seja, 12 €. O resultado é 48 €, dois euros abaixo do preço inicial.","formula":"60(1-0{,}20)=48"},{"title":"Uma regra para qualquer preço","text":"Com a mesma taxa r, em forma decimal, o fator total é 1 − r². Para r entre 0 e 1, o preço final não ultrapassa o inicial.","formula":"P(1+r)(1-r)=P(1-r^2)"},{"title":"Que desconto desfaz o aumento?","text":"Para regressar de 60 € a 50 €, retiramos 10 € de uma base de 60 €. O desconto necessário é aproximadamente 16,67%, não 20%.","formula":"\\frac{60-50}{60}\\times100\\%\\approx16{,}67\\%"}],"takeaways":["Pergunta sempre: percentagem de que valor?","Variações sucessivas multiplicam fatores.","Percentagens iguais podem representar quantias diferentes."],"exercises":[{"question":"Um artigo de 80 € sobe 25% e depois desce 20%. Qual é o preço final?","hint":"Calcula 80 × 1,25 × 0,80.","answer":"80 €: neste caso volta ao preço inicial.","explanation":"Os fatores 1,25 e 0,80 têm produto 1."},{"question":"100 € sobem 10% e depois descem 10%. Quanto fica?","hint":"O desconto incide sobre 110 €.","answer":"99 €.","explanation":"100 × 1,10 × 0,90 = 99. A redução total é de 1%."}]}]