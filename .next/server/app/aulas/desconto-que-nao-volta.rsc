17:["$","div",null,{"className":"page_page__WrTSr","children":["$","$L1f",null,{"lesson":{"slug":"desconto-que-nao-volta","title":"Sobe 20%. Desce 20%. Voltou?","subtitle":"O pequeno detalhe que muda a tua conta.","topic":"Números","years":[6,7,8,9],"minutes":15,"image":"/images/prices.svg","imageAlt":"Ilustração de etiquetas de preço com setas de aumento e desconto.","accent":"purple","date":"2026-10-29","problem":"Uma mochila custa 50 €. O preço aumenta 20% e depois recebe um desconto de 20%. O preço final volta aos 50 €?","question":"Antes de calcular: achas que acaba mais cara, mais barata ou igual?","hints":["20% de 50 € são 10 €. Qual é o preço depois do aumento?","O desconto é calculado sobre o novo preço, não sobre os 50 € iniciais.","Um aumento de 20% multiplica por 1,20. Um desconto de 20% multiplica por 0,80."],"tool":"percent","toolConfig":{"initial":{"price":50,"up":20,"down":20},"title":"Segue o preço","prompt":"Muda o aumento e o desconto. Repara no valor sobre o qual cada percentagem atua."},"steps":[{"title":"Transformar percentagens em valores","text":"Uma percentagem é uma razão por cem. Para calcular 20% de 50 €, multiplicamos 50 por 0,20.","formula":"50\\times\\frac{20}{100}=10"},{"title":"Aplicar o aumento","text":"Somamos os 10 € ao preço inicial. Também podemos fazer tudo numa multiplicação.","formula":"50(1+0{,}20)=60"},{"title":"A base de cálculo mudou","text":"Agora retiramos 20% de 60 €, ou seja, 12 €. O resultado é 48 €, dois euros abaixo do preço inicial.","formula":"60(1-0{,}20)=48"},{"title":"Uma regra para qualquer preço","text":"Com a mesma taxa r, em forma decimal, o fator total é 1 − r². Para r entre 0 e 1, o preço final não ultrapassa o inicial.","formula":"P(1+r)(1-r)=P(1-r^2)"},{"title":"Que desconto desfaz o aumento?","text":"Para regressar de 60 € a 50 €, retiramos 10 € de uma base de 60 €. O desconto necessário é aproximadamente 16,67%, não 20%.","formula":"\\frac{60-50}{60}\\times100\\%\\approx16{,}67\\%"}],"takeaways":["Pergunta sempre: percentagem de que valor?","Variações sucessivas multiplicam fatores.","Percentagens iguais podem representar quantias diferentes."],"exercises":[{"question":"Um artigo de 80 € sobe 25% e depois desce 20%. Qual é o preço final?","hint":"Calcula 80 × 1,25 × 0,80.","answer":"80 €: neste caso volta ao preço inicial.","explanation":"Os fatores 1,25 e 0,80 têm produto 1."},{"question":"100 € sobem 10% e depois descem 10%. Quanto fica?","hint":"O desconto incide sobre 110 €.","answer":"99 €.","explanation":"100 × 1,10 × 0,90 = 99. A redução total é de 1%."}]}}]}]
