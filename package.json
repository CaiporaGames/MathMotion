{
  "name": "mathmotion-aulas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"node --import tsx --test tests/rules.test.mts\" --project demo-mathmotion",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "firebase": "firebase",
    "format": "prettier --write src tests docs README.md next.config.ts"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "katex": "^0.16.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "1.107.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/katex": "^0.16.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "firebase-tools": "^15.34.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
